{
  "name": "natural-trace-website",
  "version": "1.0.0",
  "description": "Natural Trace corporate website",
  "scripts": {
    "start": "eleventy --serve --port 8080",
    "preview": "eleventy --serve --port 8080",
    "build": "eleventy",
    "check": "eleventy && node scripts/healthcheck.mjs _site",
    "check:external": "eleventy && node scripts/healthcheck.mjs _site --external",
    "check:layout": "eleventy && node scripts/layout-audit.mjs",
    "check:spacing": "eleventy && node scripts/spacing-audit.mjs",
    "check:cms": "node scripts/cms-audit.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource/montserrat": "^5.3.0"
  }
}

---
layout: base.njk
title: "Contact"
summary: "Get in touch with Natural Trace to discuss a compatibility project, schedule a consultation, or learn about our molecular traceability platform."
permalink: /contact/
---

<section class="contact-section" id="contact-form">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <span class="section-label">{{ contact.section_label }}</span>
        <h2 class="section-title">{{ contact.title }}</h2>
        <p class="section-subtitle" style="margin-bottom:2.5rem">{{ contact.subtitle | safe }}</p>

        {% for item in contact.info_items %}
        <div class="contact-info-item delay-{{ loop.index + 1 }}">
          <div class="contact-info-item-dot"></div>
          <div><h4>{{ item.label }}</h4><p>{{ item.description | safe }}</p></div>
        </div>
        {% endfor %}
      </div>
      <div class="contact-form">
        <h3>{{ contact.form.title }}</h3>
        <p>{{ contact.form.subtitle }}</p>
        <form id="contactForm"
              onsubmit="return handleContactSubmit(event)"
              data-hs-enabled="{{ integrations.hubspot.enabled }}"
              data-hs-portal="{{ integrations.hubspot.portal_id }}"
              data-hs-form="{{ integrations.hubspot.form_guid }}"
              data-hs-region="{{ integrations.hubspot.region }}"
              data-hs-map="{{ integrations.hubspot.field_map | dump }}"
              data-fallback-email="{{ integrations.fallback.email }}"
              data-fallback-subject="{{ integrations.fallback.subject_prefix }}">
          <div class="form-row">
            <div class="form-group">
              <label>{{ contact.form.first_name_label }}<span class="req" aria-hidden="true">*</span></label>
              <input type="text" name="firstName" required placeholder="{{ contact.form.first_name_placeholder }}">
            </div>
            <div class="form-group">
              <label>{{ contact.form.last_name_label }}<span class="req" aria-hidden="true">*</span></label>
              <input type="text" name="lastName" required placeholder="{{ contact.form.last_name_placeholder }}">
            </div>
          </div>
          <div class="form-group">
            <label>{{ contact.form.email_label }}<span class="req" aria-hidden="true">*</span></label>
            <input type="email" name="email" required placeholder="{{ contact.form.email_placeholder }}">
          </div>
          {#
            Company and Job Title share a row, so adding a field does not make
            the form any taller. Both are marked required because HubSpot marks
            them required on its side: a blank value is not sent at all, and
            HubSpot then rejects the whole submission. Better to ask here than
            to fail after the visitor has pressed Send.
          #}
          <div class="form-row">
            <div class="form-group">
              <label>{{ contact.form.company_label }}<span class="req" aria-hidden="true">*</span></label>
              <input type="text" name="company" required placeholder="{{ contact.form.company_placeholder }}">
            </div>
            <div class="form-group">
              <label>{{ contact.form.job_title_label }}<span class="req" aria-hidden="true">*</span></label>
              <input type="text" name="jobTitle" required placeholder="{{ contact.form.job_title_placeholder }}">
            </div>
          </div>
          <div class="form-group">
            <label>{{ contact.form.inquiry_type_label }}</label>
            {# Not required, and it is the only field here that is not.
               inquiry_type is a custom HubSpot property and is not marked
               required on that side, confirmed 7 Aug by posting a payload with
               it held out. submitContactToHubspot drops empty values before
               sending, so an unanswered Topic is simply absent rather than a
               blank that HubSpot would reject. #}
            <select name="inquiryType">
              <option value="" selected>{{ contact.form.inquiry_type_placeholder }}</option>
              {% for type in contact.inquiry_types %}
              <option value="{{ type.value }}">{{ type.label | safe }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="form-group">
            <label>{{ contact.form.message_label }}<span class="req" aria-hidden="true">*</span></label>
            <textarea name="message" required placeholder="{{ contact.form.message_placeholder }}"></textarea>
          </div>
          <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden">
            <label>Do not fill this in
              <input type="text" name="_botcheck" tabindex="-1" autocomplete="off">
            </label>
          </div>
          <button type="submit" class="form-submit">{{ contact.form.submit_text }}</button>
        </form>
        <div class="form-success" id="formSuccess">
          <h4>{{ contact.success.title }}</h4>
          <p>{{ contact.success.message }}</p>
        </div>
        <div class="form-success" id="formFallback">
          <h4>{{ contact.fallback.title }}</h4>
          <p>{{ contact.fallback.message }}</p>
        </div>
        <div class="form-success" id="formError">
          <h4>{{ contact.error.title }}</h4>
          <p>{{ contact.error.message }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{#- The photograph is blended into the panel rather than laid over it, at
    Kirsty's request on 12 Aug. It used to be a .cta-bg div holding an Unsplash
    URL hard-coded in the stylesheet at 8% opacity: not editable, and not ours.

    background-blend-mode:luminosity keeps the picture's light and shade and
    takes its colour from the sage underneath, so a shelf of coloured capsules
    becomes one tone with the panel instead of a photograph showing through it.
    Same treatment as Why We Exist on the About page.

    The url filter is required. HtmlBasePlugin does not look inside a style
    attribute, so without it the background is missing on the project-page
    prefix and correct in every local preview. -#}
<section class="cta-section{% if contact.cta.background_image %} cta-section-photo{% endif %}"
  {%- if contact.cta.background_image %} style="--cta-bg:url('{{ contact.cta.background_image | url }}')"{% endif %}>
  <div class="cta-shape cta-shape-1"></div>
  <div class="cta-shape cta-shape-2"></div>
  <div class="container">
    <div class="cta-inner">
      <span class="section-label">{{ contact.cta.section_label }}</span>
      <h2>{{ contact.cta.title }}</h2>
      <p>{{ contact.cta.subtitle }}</p>
      <div class="cta-actions">
        <a href="{{ contact.cta.primary_href }}" class="btn btn-white">{{ contact.cta.primary_text | safe }}</a>
        <a href="{{ contact.cta.secondary_href }}" class="btn btn-ghost" style="cursor:pointer">{{ contact.cta.secondary_text }}</a>
      </div>
    </div>
  </div>
</section>

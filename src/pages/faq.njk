---
layout: base.njk
title: "FAQ"
summary: "Frequently asked questions about NaturalTag molecular markers, detection methods, regulatory compliance, and supply chain integration."
permalink: /faq/
---

<section class="faq-page-hero">
  <div class="container">
    {# The colour was a style attribute here until 14 Aug. An inline style beats
       every selector short of !important, so the seasonal themes could not
       recolour this label for a red hero and the audit failed it at 2.57:1.
       The rule now lives in styles.css under .faq-page-hero .section-label,
       which looks identical and can be overridden. #}
    <span class="section-label">{{ faq.intro.label }}</span>
    <h1>{{ faq.intro.title }}</h1>
    <p>{{ faq.intro.subtitle }}</p>
  </div>
</section>
<section class="faq-section">
  <div class="container">
    <div class="faq-categories" id="faqCats">
      <button class="faq-cat-btn active" onclick="filterFaq('all')">All</button>
      {% for cat in faq.content.categories %}
      <button class="faq-cat-btn" onclick="filterFaq('{{ cat.id }}')">{{ cat.label }}</button>
      {% endfor %}
    </div>
    <div class="faq-grid" id="faqGrid">

      {% for q in faq.content.questions %}
      <div class="faq-item" data-cat="{{ q.category }}">
        <button class="faq-question" onclick="toggleFaqItem(this)">
          <span>{{ q.question }}</span>
          <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        {# An answer can end with a link (link_text / link_url, optional). It is
           rendered here and not in faq-schema.njk: the structured data carries
           the answer text alone, so the answer has to read complete without
           the link. That is also why it is a separate field rather than HTML
           inside the answer. #}
        <div class="faq-answer"><div class="faq-answer-inner">{{ q.answer }}{% if q.link_text %} <a class="faq-answer-link" href="{{ q.link_url }}">{{ q.link_text }}</a>{% endif %}</div></div>
      </div>
      {% endfor %}

    </div>
  </div>
</section>
<section class="faq-cta-bar">
  <div class="container">
    <h2>{{ faq.final_cta.title }}</h2>
    <p>{{ faq.final_cta.text }}</p>
    <a href="/contact/" class="btn btn-primary" style="cursor:pointer">{{ faq.final_cta.button }}</a>
  </div>
</section>

---
layout: base.njk
title: "About Us"
summary: "Natural Trace helps food and nutraceutical companies protect the value of their premium ingredients through in-product authentication."
permalink: /about/
---

<section class="challenge" id="about-hero" style="padding-top:9rem">
  <div class="container">
    <div class="challenge-grid">
      <div class="challenge-text">
        <span class="section-label">{{ about.label }}</span>
        {# safe on both: the headline carries a <br> and the sub-headline carries
           a <strong> and a non-breaking space, the same arrangement the Story
           headline below already uses. #}
        <h2 class="section-title">{{ about.title | safe }}</h2>
        <p class="section-subtitle section-subtitle-strong">{{ about.subtitle | safe }}</p>
        <p class="challenge-lead" style="margin-top:1.5rem">{{ about.intro }}</p>
        <p class="challenge-sub">{{ about.disciplines }}</p>
        <p class="challenge-lead">{{ about.intro_secondary }}</p>
        <a href="{{ about.hero_cta_url }}" class="btn btn-primary" style="cursor:pointer">{{ about.hero_cta }}</a>
      </div>
      <div class="challenge-media">
        <img src="{{ about.hero_image }}" alt="{{ about.hero_image_alt }}" loading="lazy">
      </div>
    </div>
  </div>
</section>

<section class="valueprop" id="story">
  <div class="container">
    <div class="vp-head">
      <span class="section-label">{{ about.story_label }}</span>
      <h2 class="section-title">{{ about.story_title | safe }}</h2>
    </div>
    <div style="max-width:780px;margin:0 auto">
      <p class="challenge-close" style="margin-top:0;font-size:1.1rem;font-weight:600">{{ about.story_question }}</p>
      {% for para in about.story_body %}
      <p class="challenge-lead" style="margin-bottom:1.15rem">{{ para }}</p>
      {% endfor %}
    </div>
  </div>
</section>

{# The photograph is a custom property so it stays a CMS field, and it goes
   through the url filter because HtmlBasePlugin rewrites src and href
   attributes and does not look inside a style attribute. Without the filter
   this emits a root-absolute path that resolves at the site root and 404s on
   the project-page prefix, so the background would be missing in production
   and correct in every local preview. Third time this has bitten; see the
   homepage hero and the CTA watermark.

   is-photo is what turns the treatment on. With no image the class is absent
   and the section is the flat charcoal it was before. #}
<section class="howitworks{% if about.why_bg_image %} howitworks-photo{% endif %}" id="why-we-exist"
  {%- if about.why_bg_image %} style="--why-bg:url('{{ about.why_bg_image | url }}')"{% endif %}>
  <div class="container">
    <div class="how-head">
      <span class="section-label">{{ about.why_label }}</span>
      <h2 class="section-title">{{ about.why_title }}</h2>
    </div>
    <div class="why-body">
      {% for para in about.why_body %}
      <p>{{ para }}</p>
      {% endfor %}
    </div>
    <div class="how-grid" style="grid-template-columns:repeat(2,1fr);margin-top:3.5rem;max-width:900px;margin-left:auto;margin-right:auto">
      <div class="how-step">
        <h3>{{ about.vision_label }}</h3>
        <p>{{ about.vision_text }}</p>
      </div>
      <div class="how-step">
        <h3>{{ about.mission_label }}</h3>
        <p>{{ about.mission_text }}</p>
        {#- Only when it has something in it. The field was emptied on 12 Aug
            rather than deleted, so without this guard the section renders an
            empty paragraph and 0.75rem of unexplained space under the mission
            statement. -#}
        {% if about.mission_body %}<p style="margin-top:.75rem">{{ about.mission_body }}</p>{% endif %}
      </div>
    </div>
  </div>
</section>

<section class="valueprop" id="different">
  <div class="container">
    <div class="vp-head">
      <h2 class="section-title">{{ about.different_label }}</h2>
      {% if about.different_title %}<p class="section-subtitle">{{ about.different_title }}</p>{% endif %}
    </div>
    <div class="vp-grid about-grid-2">
      {% for card in about.different_cards %}
      <article class="vp-card delay-{{ loop.index }}">
        <span class="vp-mark" aria-hidden="true"></span>
        <h3>{{ card.title }}</h3>
        <div class="vp-block"><p>{{ card.body }}</p></div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-industries" id="why-choose">
  <div class="container">
    <div class="industries-header">
      <span class="section-label">{{ about.choose_label }}</span>
      <h2 class="section-title">{{ about.choose_title }}</h2>
    </div>
    <div class="vp-grid about-grid-2" style="max-width:900px;margin:0 auto">
      {% for group in about.choose_groups %}
      <article class="vp-card delay-{{ loop.index }}">
        <h3>{{ group.title }}</h3>
        <ul class="sol-list" style="grid-template-columns:1fr;margin-top:0">
          {% for item in group.items %}<li>{{ item }}</li>{% endfor %}
        </ul>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# A21. Split out of the "Why Customers Choose" card at Kirsty's request so the
   claim carries its own weight. The wording is Alex's version. #}
<section class="matrices-section" id="food-matrices">
  <div class="container">
    <div class="industries-header">
      <span class="section-label">{{ about.matrices_label }}</span>
      <h2 class="section-title">{{ about.matrices_title }}</h2>
    </div>
    <ul class="matrix-chips">
      {% for item in about.matrices_items %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </div>
</section>

<section class="finalcta">
  <div class="container">
    <div class="finalcta-inner">
      <h2>{{ about.cta_title }}</h2>
      <div class="finalcta-actions">
        <a href="{{ about.cta_url }}" class="btn btn-white" style="cursor:pointer">{{ about.cta_title }}</a>
      </div>
    </div>
  </div>
</section>

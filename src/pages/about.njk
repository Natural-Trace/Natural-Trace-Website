---
layout: base.njk
title: "About Us"
summary: "Natural Trace helps food and nutraceutical companies protect the value of their premium ingredients through in-product authentication."
permalink: /about/
---

<section class="challenge" id="about-hero" style="padding-top:9rem">
  <div class="container">
    <div class="challenge-grid">
      <div class="challenge-text">
        <span class="section-label">{{ about.hero.label }}</span>
        {# safe on both: the headline carries a <br> and the sub-headline carries
           a <strong> and a non-breaking space, the same arrangement the Story
           headline below already uses. #}
        <h2 class="section-title">{{ about.hero.title | softBreak | safe }}</h2>
        <p class="section-subtitle section-subtitle-strong">{{ about.hero.subtitle | safe }}</p>
        <p class="challenge-lead" style="margin-top:1.5rem">{{ about.hero.intro }}</p>
        <p class="challenge-sub">{{ about.hero.disciplines }}</p>
        <p class="challenge-lead">{{ about.hero.intro_secondary }}</p>
        <a href="{{ about.hero.cta_url }}" class="btn btn-primary" style="cursor:pointer">{{ about.hero.cta }}</a>
      </div>
      <div class="challenge-media">
        <img src="{{ about.hero.image }}" alt="{{ about.hero.image_alt }}" loading="lazy">
      </div>
    </div>
  </div>
</section>

<section class="valueprop" id="story">
  <div class="container">
    <div class="vp-head">
      <span class="section-label">{{ about.story.label }}</span>
      <h2 class="section-title">{{ about.story.title | softBreak | safe }}</h2>
    </div>
    <div style="max-width:780px;margin:0 auto">
      <p class="challenge-close" style="margin-top:0;font-size:1.1rem;font-weight:600">{{ about.story.question }}</p>
      {% for para in about.story.body %}
      <p class="challenge-lead" style="margin-bottom:1.15rem">{{ para }}</p>
      {% endfor %}
    </div>
  </div>
</section>

{# The photograph is a custom property so it stays a CMS field, and it goes
   through the url filter because HtmlBasePlugin rewrites src and href
   attributes and does not look inside a style attribute. Without the filter
   this emits a root-absolute path that resolves at the site root and 404s on
   the project-page prefix, so the background would be missing in production
   and correct in every local preview. Third time this has bitten; see the
   homepage hero and the CTA watermark.

   is-photo is what turns the treatment on. With no image the class is absent
   and the section is the flat charcoal it was before. #}
<section class="howitworks{% if about.why.bg_image %} howitworks-photo{% endif %}" id="why-we-exist"
  {%- if about.why.bg_image %} style="--why-bg:url('{{ about.why.bg_image | url }}')"{% endif %}>
  <div class="container">
    <div class="how-head">
      <span class="section-label">{{ about.why.label }}</span>
      <h2 class="section-title">{{ about.why.title }}</h2>
    </div>
    <div class="why-body">
      {% for para in about.why.body %}
      <p>{{ para }}</p>
      {% endfor %}
    </div>
    <div class="how-grid" style="grid-template-columns:repeat(2,1fr);margin-top:3.5rem;max-width:900px;margin-left:auto;margin-right:auto">
      <div class="how-step">
        <h3>{{ about.vision.label }}</h3>
        <p>{{ about.vision.text }}</p>
      </div>
      <div class="how-step">
        <h3>{{ about.mission.label }}</h3>
        <p>{{ about.mission.text }}</p>
        {#- Only when it has something in it. The field was emptied on 12 Aug
            rather than deleted, so without this guard the section renders an
            empty paragraph and 0.75rem of unexplained space under the mission
            statement. -#}
        {% if about.mission.body %}<p style="margin-top:.75rem">{{ about.mission.body }}</p>{% endif %}
      </div>
    </div>
  </div>
</section>

<section class="valueprop" id="different">
  <div class="container">
    <div class="vp-head">
      <h2 class="section-title">{{ about.different.label }}</h2>
      {% if about.different.title %}<p class="section-subtitle">{{ about.different.title }}</p>{% endif %}
    </div>
    <div class="vp-grid about-grid-2">
      {% for card in about.different.cards %}
      <article class="vp-card delay-{{ loop.index }}">
        {# A tick, at Kirsty's request, in place of the diamond that replaced the
           01-04 counters on 11 Aug. Inline rather than an image file so it
           inherits its colour from the stylesheet, stays sharp at any size and
           costs no extra request. aria-hidden because it decorates the heading
           below it and has nothing of its own to say. #}
        <span class="vp-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4.6 12.7 9.5 17.6 19.4 6.8"/></svg>
        </span>
        <h3>{{ card.title }}</h3>
        <div class="vp-block"><p>{{ card.body }}</p></div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-industries" id="why-choose">
  <div class="container">
    <div class="industries-header">
      <span class="section-label">{{ about.choose.label }}</span>
      <h2 class="section-title">{{ about.choose.title }}</h2>
    </div>
    {# The width and the row alignment are in the stylesheet now, not in style
       attributes here. The old inline max-width:900px left the longer heading
       23px of room on a 390px card, which held on this machine and wrapped on
       Bryan's: Windows sets Montserrat a few per cent wider than Linux does,
       and 23px is inside that margin. #}
    <div class="vp-grid about-grid-2 choose-grid">
      {% for group in about.choose.groups %}
      <article class="vp-card delay-{{ loop.index }}">
        {# safe: these titles carry &nbsp; around their ampersand so the
           heading cannot break with the & stranded at the end of a line. #}
        <h3>{{ group.title | safe }}</h3>
        <ul class="sol-list">
          {% for item in group.items %}<li>{{ item }}</li>{% endfor %}
        </ul>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# A21. Split out of the "Why Customers Choose" card at Kirsty's request so the
   claim carries its own weight. The wording is Alex's version. #}
<section class="matrices-section" id="food-matrices">
  <div class="container">
    <div class="industries-header">
      <span class="section-label">{{ about.matrices.label }}</span>
      <h2 class="section-title">{{ about.matrices.title }}</h2>
    </div>
    <ul class="matrix-chips">
      {% for item in about.matrices.items %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </div>
</section>

<section class="finalcta">
  <div class="container">
    <div class="finalcta-inner">
      <h2>{{ about.final_cta.title }}</h2>
      <div class="finalcta-actions">
        <a href="{{ about.final_cta.url }}" class="btn btn-white" style="cursor:pointer">{{ about.final_cta.title }}</a>
      </div>
    </div>
  </div>
</section>

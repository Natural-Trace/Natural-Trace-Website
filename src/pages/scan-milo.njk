# These pages exist for one audience: someone holding their phone at our event
# stand two seconds after scanning a jar. They are deliberately unlinked from
# the navigation, kept out of the sitemap (the exclusion below is what does
# that — see src/sitemap.njk) and marked noindex, because a search visitor
# landing on "you scanned the left jar" with no jar in front of them would
# only be confused. Scan counting happens before this page loads, in the
# Cloudflare worker under qr/ — nothing on this page tracks anything.
eleventyExcludeFromCollections: true
noindex: true

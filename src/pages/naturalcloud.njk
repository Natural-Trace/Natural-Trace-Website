---
layout: base.njk
title: "NaturalCloud™"
summary: "NaturalCloud™ securely stores authentication records and NaturalDetect™ test results, giving companies a centralized view of verification activity."
permalink: /naturalcloud/
---

<section class="challenge hero-cloud" style="padding-top:9rem">
  <div class="container">
    <div class="challenge-grid">
      <div class="challenge-text">
        <span class="section-label">{{ naturalcloud.label }}</span>
        <h2 class="section-title">{{ naturalcloud.title }}</h2>
        <p class="section-subtitle">{{ naturalcloud.hero }}</p>
        <p class="challenge-lead" style="margin-top:1.5rem">{{ naturalcloud.intro }}</p>
        <p class="challenge-sub">{{ naturalcloud.features_title }}</p>
        <ul class="challenge-list">
          {% for item in naturalcloud.features %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem">
          <a href="{{ naturalcloud.cta_primary_url }}" class="btn btn-primary" style="cursor:pointer">{{ naturalcloud.cta_primary }}</a>
        </div>
      </div>
      {# A photograph if there is one, the logo panel if not. NaturalCloud is
         still on the panel: its imagery is a video Kirsty is having made, and
         a stand-in photograph would be worse than the mark. #}
      {% if naturalcloud.hero_image %}
      <div class="solution-photo">
        <img src="{{ naturalcloud.hero_image }}" alt="{{ naturalcloud.hero_image_alt }}" loading="lazy">
      </div>
      {% else %}
      <div class="solution-mark">
        <img src="{{ naturalcloud.hero_logo }}" alt="{{ naturalcloud.hero_logo_alt }}" loading="lazy">
      </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="finalcta">
  <div class="container">
    <div class="finalcta-inner">
      <h2>{{ naturalcloud.cta_secondary }}</h2>
      <div class="finalcta-actions">
        <a href="{{ naturalcloud.cta_primary_url }}" class="btn btn-white" style="cursor:pointer">{{ naturalcloud.cta_primary }}</a>
      </div>
    </div>
  </div>
</section>

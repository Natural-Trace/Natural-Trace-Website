---
layout: base.njk
title: "NaturalDetect™"
summary: "NaturalDetect™ is a proprietary PCR-based laboratory test that confirms whether a product contains the authentic NaturalTag™ signature."
permalink: /naturaldetect/
---

{# The product mark, blended into the hero rather than sitting in a panel.
   Kirsty asked for the product icons to be somewhere on the page once the
   hero panel became a photograph. Same technique as the call-to-action
   watermark: the icon is a mask, so the colour comes from the stylesheet
   and the mark sits tonally on this page's own tint instead of being
   stamped on it in whatever colour the file happens to be.

   The class only appears when a mark is set, so clearing the field in the
   panel removes it. The url filter is required: HtmlBasePlugin does not
   look inside a style attribute. #}
<section class="challenge hero-detect{% if naturaldetect.hero.mark %} solution-hero-mark{% endif %}"
  style="padding-top:9rem{% if naturaldetect.hero.mark %};--hero-mark:url('{{ naturaldetect.hero.mark | url }}'){% endif %}">
  <div class="container">
    <div class="challenge-grid">
      <div class="challenge-text">
        <span class="section-label">{{ naturaldetect.hero.label }}</span>
        <h2 class="section-title">{{ naturaldetect.hero.title }}</h2>
        <p class="section-subtitle">{{ naturaldetect.hero.tagline }}</p>
        <p class="challenge-lead" style="margin-top:1.5rem">{{ naturaldetect.hero.intro }}</p>
        <p class="challenge-sub">{{ naturaldetect.features.title }}</p>
        <ul class="challenge-list">
          {% for item in naturaldetect.features.items %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem">
          <a href="{{ naturaldetect.final_cta.primary_url }}" class="btn btn-primary" style="cursor:pointer">{{ naturaldetect.final_cta.primary }}</a>
          <a href="{{ naturaldetect.final_cta.secondary_url }}" class="btn btn-line" style="cursor:pointer">{{ naturaldetect.final_cta.secondary }}</a>
        </div>
      </div>
      {# A photograph if there is one, the logo panel if not. NaturalCloud is
         still on the panel: its imagery is a video Kirsty is having made, and
         a stand-in photograph would be worse than the mark. #}
      {% if naturaldetect.hero.image %}
      <div class="solution-photo">
        <img src="{{ naturaldetect.hero.image }}" alt="{{ naturaldetect.hero.image_alt }}" loading="lazy"
          style="{% if naturaldetect.hero.image_position %}object-position:{{ naturaldetect.hero.image_position }};{% endif %}{% if naturaldetect.hero.image_zoom %}--photo-zoom:{{ naturaldetect.hero.image_zoom }};--photo-zoom-origin:{{ naturaldetect.hero.image_position or "center" }}{% endif %}">
      </div>
      {% else %}
      <div class="solution-mark">
        <img src="{{ naturaldetect.hero.logo }}" alt="{{ naturaldetect.hero.logo_alt }}" loading="lazy">
      </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="finalcta">
  <div class="container">
    <div class="finalcta-inner">
      <h2>{{ naturaldetect.final_cta.primary }}</h2>
      <p>Send us your product details and one of our scientists will review compatibility with you.</p>
      <div class="finalcta-actions">
        <a href="{{ naturaldetect.final_cta.primary_url }}" class="btn btn-white" style="cursor:pointer">{{ naturaldetect.final_cta.primary }}</a>
      </div>
    </div>
  </div>
</section>

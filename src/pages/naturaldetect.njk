---
layout: base.njk
title: "NaturalDetect™"
summary: "NaturalDetect™ is a proprietary PCR-based laboratory test that confirms whether a product contains the authentic NaturalTag™ signature."
permalink: /naturaldetect/
---

<section class="challenge hero-detect" style="padding-top:9rem">
  <div class="container">
    <div class="challenge-grid">
      <div class="challenge-text">
        <span class="section-label">{{ naturaldetect.label }}</span>
        <h2 class="section-title">{{ naturaldetect.title }}</h2>
        <p class="section-subtitle">{{ naturaldetect.hero }}</p>
        <p class="challenge-lead" style="margin-top:1.5rem">{{ naturaldetect.intro }}</p>
        <p class="challenge-sub">{{ naturaldetect.features_title }}</p>
        <ul class="challenge-list">
          {% for item in naturaldetect.features %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem">
          <a href="{{ naturaldetect.cta_primary_url }}" class="btn btn-primary" style="cursor:pointer">{{ naturaldetect.cta_primary }}</a>
          <a href="{{ naturaldetect.cta_secondary_url }}" class="btn btn-line" style="cursor:pointer">{{ naturaldetect.cta_secondary }}</a>
        </div>
      </div>
      {# A photograph if there is one, the logo panel if not. NaturalCloud is
         still on the panel: its imagery is a video Kirsty is having made, and
         a stand-in photograph would be worse than the mark. #}
      {% if naturaldetect.hero_image %}
      <div class="solution-photo">
        <img src="{{ naturaldetect.hero_image }}" alt="{{ naturaldetect.hero_image_alt }}" loading="lazy">
      </div>
      {% else %}
      <div class="solution-mark">
        <img src="{{ naturaldetect.hero_logo }}" alt="{{ naturaldetect.hero_logo_alt }}" loading="lazy">
      </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="finalcta">
  <div class="container">
    <div class="finalcta-inner">
      <h2>{{ naturaldetect.cta_primary }}</h2>
      <p>Send us your product details and one of our scientists will review compatibility with you.</p>
      <div class="finalcta-actions">
        <a href="{{ naturaldetect.cta_primary_url }}" class="btn btn-white" style="cursor:pointer">{{ naturaldetect.cta_primary }}</a>
      </div>
    </div>
  </div>
</section>

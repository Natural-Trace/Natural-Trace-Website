---
layout: base.njk
title: "Insights"
summary: "Articles and updates from Natural Trace on molecular traceability, supply chain authenticity, and the natural products industry."
pagination:
  data: collections.insightsRegular
  size: 9
  alias: posts
permalink: "{% if pagination.pageNumber == 0 %}/insights/{% else %}/insights/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
{#-
  Nine per page.

  Nine because the grid is three across on a desktop, so a page is three full
  rows with nothing left hanging. The archive is nineteen articles after the
  WordPress migration, which is more than anyone scrolls through to reach 2022.

  Only the chronological articles are paginated. The pinned one, "Welcome to
  Natural Trace Insights", is evergreen rather than news and is appended to the
  last page, where an introduction to an archive belongs. That is also what
  makes the pages come out even: eighteen dated articles is exactly two pages,
  where paginating all nineteen gave a third page holding one article.

  Page one keeps /insights/, so nothing linking to it has to change, and the
  rest are /insights/page/2/ onwards.
-#}

<section class="insights-listing">
  <div class="container">
    <div class="insights-header">
      <span class="section-label">Insights</span>
      {#- The heading says which page you are on, because "News & Updates" at
          the top of page three is disorienting and because two pages sharing a
          title is two pages competing for the same search result. -#}
      <h1>News &amp; Updates{% if pagination.pageNumber > 0 %} <span class="insights-page-of">page {{ pagination.pageNumber + 1 }}</span>{% endif %}</h1>
      {% if pagination.pageNumber == 0 %}
      <p class="insights-subtitle">The latest from Natural Trace: product developments, industry perspectives and company news.</p>
      {% endif %}
    </div>

    {% if posts.length > 0 %}
    <div class="insights-grid">
      {% for post in posts %}
      <article class="insight-card">
        {% if post.data.image %}
        <div class="insight-card-image">
          <a href="{{ post.url }}">
            <img src="{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy">
          </a>
        </div>
        {% endif %}
        <div class="insight-card-content">
          <time datetime="{{ post.date | date('%Y-%m-%d') }}">{{ post.date | date('%B %d, %Y') }}</time>
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          {% if post.data.summary %}
          <p>{{ post.data.summary }}</p>
          {% endif %}
          {% if post.data.tags %}
          <div class="insight-tags">
            {% for tag in post.data.tags %}
            <span class="insight-tag">{{ tag }}</span>
            {% endfor %}
          </div>
          {% endif %}
          <a href="{{ post.url }}" class="read-more">Read more</a>
        </div>
      </article>
      {% endfor %}

      {#- The evergreen introduction, on the last page only. Repeating it on
          every page would be noise, and putting it on the first would push
          this month's news below a welcome message written in July. -#}
      {% if not pagination.href.next %}
      {% for post in collections.insightsPinned %}
      <article class="insight-card insight-card--pinned">
        {% if post.data.image %}
        <div class="insight-card-image">
          <a href="{{ post.url }}"><img src="{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy"></a>
        </div>
        {% endif %}
        <div class="insight-card-content">
          <time datetime="{{ post.date | date('%Y-%m-%d') }}">{{ post.date | date('%B %d, %Y') }}</time>
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          {% if post.data.summary %}<p>{{ post.data.summary }}</p>{% endif %}
          {% if post.data.tags %}
          <div class="insight-tags">
            {% for tag in post.data.tags %}<span class="insight-tag">{{ tag }}</span>{% endfor %}
          </div>
          {% endif %}
          <a href="{{ post.url }}" class="read-more">Read more</a>
        </div>
      </article>
      {% endfor %}
      {% endif %}
    </div>

    {% if pagination.pages.length > 1 %}
    {#- A numbered pager rather than "load more". Every page is a real URL that
        can be linked, bookmarked and indexed, and someone who wants 2022 can
        jump to the last page instead of pressing a button eight times. -#}
    <nav class="insights-pager" aria-label="Insights pages">
      {% if pagination.href.previous %}
      <a class="insights-pager-step" href="{{ pagination.href.previous }}" rel="prev">
        <span aria-hidden="true">&larr;</span> Newer
      </a>
      {% else %}
      <span class="insights-pager-step is-off"><span aria-hidden="true">&larr;</span> Newer</span>
      {% endif %}

      <ol class="insights-pager-numbers">
        {% for entry in pagination.pages %}
        <li>
          {% if loop.index0 == pagination.pageNumber %}
          <span class="insights-pager-num is-current" aria-current="page">{{ loop.index }}</span>
          {% else %}
          <a class="insights-pager-num" href="{{ pagination.hrefs[loop.index0] }}"
             aria-label="Page {{ loop.index }}">{{ loop.index }}</a>
          {% endif %}
        </li>
        {% endfor %}
      </ol>

      {% if pagination.href.next %}
      <a class="insights-pager-step" href="{{ pagination.href.next }}" rel="next">
        Older <span aria-hidden="true">&rarr;</span>
      </a>
      {% else %}
      <span class="insights-pager-step is-off">Older <span aria-hidden="true">&rarr;</span></span>
      {% endif %}
    </nav>
    {% endif %}

    {% else %}
    <div class="insights-empty">
      <h2>Coming Soon</h2>
      <p>We're preparing our first insights. Check back soon for news, updates, and industry perspectives from the Natural Trace team.</p>
    </div>
    {% endif %}
  </div>
</section>

---
layout: base.njk
title: "Our Team"
summary: "Meet the scientists, engineers, and advisors behind Natural Trace molecular authenticity verification platform."
permalink: /team/
---

<section class="privacy-page" style="background:var(--offwhite)">
  <div class="container">
    <a class="privacy-back" href="/about/">Back to About</a>
    <div style="text-align:center;margin-bottom:3rem;max-width:760px;margin-left:auto;margin-right:auto">
      <span class="section-label">{{ team.leadership_label }}</span>
      <h2 class="section-title">{{ team.hero_title }}</h2>
      <p class="section-subtitle" style="margin:0 auto">{{ team.hero_subtitle }}</p>
    </div>
    <div class="team-grid">
      {% for member in team.members %}{% if member.type == "leadership" %}
      <div class="team-card" onclick="openTeamModal({{ loop.index0 }})" style="cursor:pointer">
        <div class="team-avatar"><img src="{{ member.photo }}" alt="{{ member.name }}"></div>
        <div class="team-card-info">
          <h4>{{ member.name }}</h4>
          <p class="team-role">{{ member.role }}</p>
          <p class="team-loc">{{ member.location }}</p>
        </div>
      </div>
      {% endif %}{% endfor %}
    </div>

    <div style="text-align:center;margin:4rem 0 2rem">
        <h2 class="section-title" style="font-size:clamp(1.5rem,2.8vw,2rem)">{{ team.advisors_label }}</h2>
    </div>
    <div class="team-grid advisor-grid">
      {% for member in team.members %}{% if member.type == "advisor" %}
      <div class="team-card" onclick="openTeamModal({{ loop.index0 }})" style="cursor:pointer">
        <div class="team-avatar"><img src="{{ member.photo }}" alt="{{ member.name }}"></div>
        <div class="team-card-info">
          <h4>{{ member.name }}</h4>
          <p class="team-role">{{ member.role }}</p>
        </div>
      </div>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<!-- Team Modal -->
<div class="team-modal-overlay" id="teamModal">
  <div class="team-modal">
    {# No src attribute rather than src="". An empty src is resolved against the
       current document, so the browser requested the team page again as an
       image on every load and then reported it as a broken image. The src is
       set by openTeamModal before the modal is shown. #}
    <div class="team-modal-photo"><img id="modalPhoto" alt=""></div>
    <div class="team-modal-body">
      <button class="team-modal-close" onclick="closeTeamModal()">&times;</button>
      <h3 id="modalName"></h3>
      <p class="tm-role" id="modalRole"></p>
      <p class="tm-loc" id="modalLoc"></p>
      <div class="tm-edu" id="modalEdu"></div>
      <ul class="tm-bio" id="modalBio"></ul>
      <a class="team-modal-linkedin" id="modalLinkedin" href="" target="_blank" rel="noopener" title="LinkedIn">in</a>
    </div>
  </div>
</div>

<script>
var teamData = {{ team.members | dump | safe }};
var basePrefix = "{{ sitePathPrefix }}";
</script>

<section class="finalcta">
  <div class="container">
    <div class="finalcta-inner">
      <h2>{{ team.cta_text }}</h2>
      <div class="finalcta-actions">
        <a href="{{ team.cta_url }}" class="btn btn-white" style="cursor:pointer">Request a Compatibility Assessment</a>
      </div>
    </div>
  </div>
</section>

---
layout: base.njk
pagination:
  data: collections.tagPages
  size: 1
  alias: t
  # Eleventy adds only the FIRST page of a paginated template to collections.
  # This template is paginated one topic per page, so without this flag exactly
  # one of the six topic archives existed as far as collections.all was
  # concerned, and src/sitemap.njk iterates collections.all. The sitemap listed
  # /insights/tag/company-news/ and silently omitted the other five: valid XML,
  # a clean build, no warning anywhere, and five real indexable pages missing
  # from the file whose entire job is to list them.
  #
  # Found on 7 September 2026 while reading a Search Console export. Nothing
  # reported it because nothing could: an incomplete sitemap is not an error,
  # it is a shorter file.
  #
  # collections.all has exactly one consumer, sitemap.njk, so widening it here
  # affects the sitemap and nothing else. The Insights pager is deliberately
  # left alone: /insights/ is in the sitemap and /insights/page/2/ is not,
  # which is the normal treatment for a paginated series whose articles are
  # each listed in their own right.
  addAllPagesToCollections: true
permalink: "/insights/tag/{{ t.slug }}/"
eleventyComputed:
  # | safe on all three, and it is not optional once a topic contains an
  # ampersand. These interpolations produce a data value rather than markup:
  # base.njk escapes whatever lands in title and summary when it prints them.
  # Without safe the escaping happens twice, so "Science & Evidence" was
  # reaching the browser tab as "Science &amp;amp; Evidence" while the h1 in
  # the body below, which is printed once, was correct. Only the title and the
  # meta description were wrong, which is the pair nobody looks at.
  title: "{{ t.tag | safe }}"
  summary: "Natural Trace articles tagged {{ t.tag | safe }}. {{ t.posts.length }} pieces on {{ t.tag | lower | safe }}, covering in-product authentication for food and nutraceutical ingredients."
---
{#
  One page per tag, generated only for tags that clear the threshold in
  .eleventy.js. See the comment there for why the threshold exists.
#}
<section class="insights-hero">
  <div class="container">
    <div class="insights-header">
      <a class="privacy-back" href="/insights/">Back to Insights</a>
      <span class="section-label">Tagged</span>
      <h1 class="section-title">{{ t.tag }}</h1>
      <p class="section-subtitle">{{ t.posts.length }} article{% if t.posts.length != 1 %}s{% endif %} on this topic.</p>
    </div>
  </div>
</section>

<section class="insights-list">
  <div class="container">
    {#- The same topic control as the index, with this archive selected, so a
        reader can move between topics without going back to the index first.
        Added 3 Sep 2026 when the control became navigation. -#}
    {% set currentTopic = t.tag %}
    {% include "partials/insights-topic-select.njk" %}
    <div class="insights-rows">
      {% for post in t.posts %}
        {% include "partials/insight-row.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

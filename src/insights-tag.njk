---
layout: base.njk
pagination:
  data: collections.tagPages
  size: 1
  alias: t
permalink: "/insights/tag/{{ t.slug }}/"
eleventyComputed:
  # | safe on all three, and it is not optional once a topic contains an
  # ampersand. These interpolations produce a data value rather than markup:
  # base.njk escapes whatever lands in title and summary when it prints them.
  # Without safe the escaping happens twice, so "Science & Evidence" was
  # reaching the browser tab as "Science &amp;amp; Evidence" while the h1 in
  # the body below, which is printed once, was correct. Only the title and the
  # meta description were wrong, which is the pair nobody looks at.
  title: "{{ t.tag | safe }}"
  summary: "Natural Trace articles tagged {{ t.tag | safe }}. {{ t.posts.length }} pieces on {{ t.tag | lower | safe }}, covering in-product authentication for food and nutraceutical ingredients."
---
{#
  One page per tag, generated only for tags that clear the threshold in
  .eleventy.js. See the comment there for why the threshold exists.
#}
<section class="insights-hero">
  <div class="container">
    <div class="insights-header">
      <a class="privacy-back" href="/insights/">Back to Insights</a>
      <span class="section-label">Tagged</span>
      <h1 class="section-title">{{ t.tag }}</h1>
      <p class="section-subtitle">{{ t.posts.length }} article{% if t.posts.length != 1 %}s{% endif %} on this topic.</p>
    </div>
  </div>
</section>

<section class="insights-list">
  <div class="container">
    <div class="insights-rows">
      {% for post in t.posts %}
        {% include "partials/insight-row.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

---
layout: base.njk
pagination:
  data: collections.tagPages
  size: 1
  alias: t
permalink: "/insights/tag/{{ t.slug }}/"
eleventyComputed:
  title: "{{ t.tag }}"
  summary: "Natural Trace articles tagged {{ t.tag }}. {{ t.posts.length }} pieces on {{ t.tag | lower }}, covering in-product authentication for food and nutraceutical ingredients."
---
{#
  One page per tag, generated only for tags that clear the threshold in
  .eleventy.js. See the comment there for why the threshold exists.
#}
<section class="insights-hero">
  <div class="container">
    <div class="insights-header">
      <a class="privacy-back" href="/insights/">Back to Insights</a>
      <span class="section-label">Tagged</span>
      <h1 class="section-title">{{ t.tag }}</h1>
      <p class="section-subtitle">{{ t.posts.length }} article{% if t.posts.length != 1 %}s{% endif %} on this topic.</p>
    </div>
  </div>
</section>

<section class="insights-list">
  <div class="container">
    <div class="insights-rows">
      {% for post in t.posts %}
        {% include "partials/insight-row.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

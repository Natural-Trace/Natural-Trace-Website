<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{%- if themes.enabled %}
{# Seasonal theme detector. Definitions are in src/_data/themes.yml.

   This runs in the browser rather than at build time for two reasons. The site
   is a static build, so nothing rebuilds on 4 May by itself and a build-time
   theme would simply never appear. And the date that matters is the visitor's:
   deciding Singapore National Day from a UTC build machine starts it eight
   hours late in Singapore.

   It is a blocking script in <head>, so the attribute is on <html> before the
   first paint and there is no flash of the untinted page. Everything is inside
   a try, because a malformed date in a CMS field must not be able to stop a
   page rendering. #}
<script>
(function(){try{
var T=[{% for t in themes.themes %}{% if t.enabled %}{k:"{{ t.key }}",s:"{{ t.starts }}",e:"{{ t.ends }}"},{% endif %}{% endfor %}];
var h=document.documentElement,q=null,S=null;
try{S=window.sessionStorage}catch(e){}
try{q=new URLSearchParams(location.search).get('theme')}catch(e){}
/* ?theme= sticks for the rest of the tab. Without this a preview lasts
   exactly one page: click any link and the query string is gone, which makes
   checking a theme across 36 pages unusable. sessionStorage, not local, so it
   dies with the tab and cannot follow a real visitor around. ?theme=off
   clears it. */
if(q!==null){
  if(q&&q!=='off'){h.setAttribute('data-theme',q);if(S)S.setItem('nt-theme',q);return}
  if(S)S.removeItem('nt-theme');return
}
var p=S&&S.getItem('nt-theme');
if(p){h.setAttribute('data-theme',p);return}
var n=new Date(),p=function(v){return(v<10?'0':'')+v},
    md=p(n.getMonth()+1)+'-'+p(n.getDate());
for(var i=0;i<T.length;i++){var s=T[i].s,e=T[i].e;
  if(s<=e?(md>=s&&md<=e):(md>=s||md<=e)){h.setAttribute('data-theme',T[i].k);break}}
}catch(e){}})();
</script>
{%- endif %}
{%- set s = seo.pages | seoLookup(page.url) -%}
{#- Order of preference: the entry in seo.yml, then anything the page sets for
    itself (Insights articles do this), then the page title and summary. So an
    article gets sensible search wording with no extra work, and can override it
    when the headline that reads well on the page is not the one that reads well
    in Google. -#}
{%- set seoTitle = s.title or seo_title or title -%}
{%- set seoDescription = (s.description or seo_description or summary or site.default_summary) | truncate(157, false, "…") -%}
{#- Every tab carries the brand, but the homepage carries it FIRST. A tab is
    narrow and truncates from the right, so a trailing " | Natural Trace" is the
    first thing to disappear: the home tab used to read "In-Product Authe..."
    with the company name nowhere in sight. Its seo.yml title now leads with the
    name, and this guard stops the suffix being added on top of it. The test is
    the brand appearing anywhere in the title rather than a check on the home
    URL, so any page whose title names the company is covered too. -#}
{%- set pageTitle = seoTitle or "" -%}
{%- if not pageTitle -%}{%- set pageTitle = site.name -%}
{%- elif site.name not in pageTitle -%}{%- set pageTitle = pageTitle + " | " + site.name -%}
{%- endif -%}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ seoDescription }}">
{% if site.google_site_verification %}{# Proves to Google that whoever pastes this
   token controls the site, which is how a Search Console property is claimed.
   Rendered on every page because Google checks the homepage but the extra tag
   costs nothing and survives someone verifying a different page later.
   Set from the CMS, so claiming the property never needs a developer again. #}
<meta name="google-site-verification" content="{{ site.google_site_verification }}">{% endif %}
{% if not site.search_indexable %}{# Holding switch in src/_data/site.yml. data-hold marks this as the
   site-wide hold rather than a genuinely noindex page, so the health check
   still validates titles, descriptions and canonicals underneath it. #}
<meta name="robots" content="noindex, nofollow" data-hold="site">
{%- elif noindex %}{# Per-page opt-out, set in front matter. First used by the
   /scan/ pages behind the event QR codes, which only make sense to someone
   standing at the stand. No data-hold: the health check should treat these as
   genuinely noindex and skip its SEO checks. elif, not a second if, so the
   site-wide hold and a page flag never emit two robots tags. #}
<meta name="robots" content="noindex, nofollow">{% endif %}
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ seoDescription }}">
<meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if image %}<meta property="og:image" content="{{ site.url }}{{ image }}">{% endif %}
<meta property="og:site_name" content="Natural Trace">
<meta name="twitter:card" content="summary_large_image">
{% if layout == "layouts/post.njk" and author %}<meta name="author" content="{{ author }}">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{#- Feed discovery. Without this, a reader or a scheduler pointed at the site
    has to be told the feed URL by hand; with it, pasting natural-trace.com is
    enough for anything that speaks RSS to find /feed.xml on its own. -#}
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} Insights" href="{{ site.url }}/feed.xml">
<link rel="icon" type="image/png" href="/assets/logos/NT icon without logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
{# ?v= is a content hash, set in .eleventy.js. Without it a returning
   visitor keeps the stylesheet they cached last time, which is how a fixed
   layout can stay broken on screen after a deploy. #}
<link rel="stylesheet" href="/assets/css/styles.css?v={{ assetVersions.css }}">
{%- if themes.enabled %}
{# Seasonal accents, kept out of styles.css so the main sheet cannot be broken
   by a theme and a theme can be reverted without touching it. #}
<link rel="stylesheet" href="/assets/css/themes.css?v={{ assetVersions.themes }}">
{%- endif %}
{%- if site.cta_mark %}
{# The CTA watermark is set here rather than in the stylesheet so it stays a
   CMS field. The url filter is required: HtmlBasePlugin rewrites src and href
   attributes and does not look inside a style element, so without it this
   emits a root-absolute /assets/... that 404s on the project-page path prefix
   and the mark silently disappears in production only. Same failure class as
   the hero background on 12 Aug and the redirect stubs on 11 Aug. #}
<style>:root{--cta-mark:url('{{ site.cta_mark | url }}')}</style>
{%- endif %}
</head>
{#- bodyClass lets a page ask for its own styling hook from front matter.
    /scan/ uses it: that page carries a full-page background mark the rest of
    the site does not, and scoping it to a class keeps it out of every other
    page's stylesheet path. -#}
<body class="{% if page.url == sitePathPrefix or page.url == '/' %}page-home{% endif %}{% if bodyClass %} {{ bodyClass }}{% endif %}">

{% include "partials/nav.njk" %}

<main>
  {{ content | safe }}
</main>

{% include "partials/theme-ribbon.njk" %}

{% include "partials/footer.njk" %}

{% include "partials/structured-data.njk" %}
{% if permalink == "/faq/" %}
{% include "partials/faq-schema.njk" %}
{% endif %}

{% include "partials/consent.njk" %}

{%- if integrations.cloudflare_analytics.enabled and integrations.cloudflare_analytics.token %}
{# Cloudflare Web Analytics. Outside the consent gate on purpose: it sets no
   cookies and stores nothing on the device, which is why it was chosen over
   GA4. Anything that does set a cookie belongs in partials/consent.njk with
   the HubSpot loader instead, and putting it here would make the privacy
   policy untrue.

   type="module" because that is the form Cloudflare's own snippet now uses, and
   a module loaded as a classic script throws on its first export. Modules defer
   by default, so this still never blocks a page opened on venue wifi seconds
   after a scan. #}
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "{{ integrations.cloudflare_analytics.token }}"}'></script>
{%- endif %}
{%- if integrations.posthog.enabled and integrations.posthog.token %}
{# PostHog product analytics. Added 3 Sep 2026.

   It sits here beside Cloudflare rather than behind the banner in
   partials/consent.njk, which reads as a breach of the rule written above the
   Cloudflare block. It is not, because of cookieless_mode: "on_reject". PostHog
   starts in a mode that sets no cookie: visitors are counted by a hash
   computed on PostHog's servers from IP and browser, under a salt that
   rotates daily, so one person reads as a new person tomorrow. The one thing
   it keeps on the device is an opt-out flag in localStorage, the same class
   of record as the banner's own nt-consent key. Only after Accept on the
   banner does it switch to a cookie, and only then can session replay run.
   Decline keeps it cookieless. The promise on the privacy page therefore
   holds for everyone who has not consented, which is nearly everyone.

   Verified in the browser on 3 Sep 2026 with a dummy token: no cookie before
   a choice, none after Decline, a ph_ cookie only after Accept, each of which
   survives navigating to the next page; HubSpot loads only after Accept. What
   a dummy token cannot prove is that a cookieless event leaves the browser.
   Cookied ones did. Cookieless ones did not, and PostHog's docs say the
   project needs "Cookieless server hash mode" switched on under Project
   Settings, Web analytics, which the SDK evidently confirms from remote
   config before it will send. So on the first real deploy, open the site in
   a private window, ignore the banner, and check that a pageview arrives in
   PostHog. Until that is seen, the un-consented majority is not being counted
   here, only by Cloudflare.

   The trap: in on_reject mode PostHog captures NOTHING until it is told the
   visitor's choice. A visitor who never touches the banner, which is what a
   visitor at a stand does, would be invisible again, the exact hole Cloudflare
   was added to close. So "no choice yet" is treated below as opt-out, meaning
   "count them cookielessly", and decide() in partials/consent.njk upgrades it
   to opt-in when Accept is tapped. opt_out_capturing() in this mode does not
   stop capture; it keeps it cookieless.

   The stub is PostHog's own, copied verbatim from
   posthog.com/docs/integrate/snippet.mdx on 3 Sep 2026. Its job is to queue
   calls made before array.js arrives, which is why decide() can call
   opt_in_capturing() on slow venue wifi and not lose the choice. Do not trim
   the method list: a method missing from it is dropped, not queued.

   Session replay is deliberately not configured here. Whether it records at
   all is a switch in the PostHog project settings, and on_reject already
   refuses to record anyone who has not accepted. Inputs are masked by default,
   which covers the contact form. Click capture, rage clicks and heatmaps need
   no cookie and work for everyone.

   The token is the public project key, published in every page like the
   Cloudflare one. It is not an API key and grants nothing. #}
<script>
!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
(function () {
  posthog.init({{ integrations.posthog.token | dump | safe }}, {
    api_host: 'https://{{ integrations.posthog.region }}.i.posthog.com',
    defaults: '2025-05-24',
    cookieless_mode: 'on_reject',
    person_profiles: 'identified_only',
    enable_heatmaps: true,
    /* The automatic pageview fires inside init(), while on_reject still has
       consent as "pending", and a pending event is discarded rather than
       held. Seen on the live site on 3 Sep 2026: a cookieless visit
       delivered its clicks and quiz events and no pageview at all. So the
       pageview is sent by hand below, after the consent state is set. */
    capture_pageview: false,
    capture_pageleave: true
  });
  /* Same key the banner writes. Read here as well as there so the choice is
     honoured on every page, including ones where the banner is not shown. */
  var choice = null;
  try { choice = localStorage.getItem('nt-consent'); } catch (e) {}
  if (choice === 'accepted') posthog.opt_in_capturing();
  else posthog.opt_out_capturing();
  posthog.capture('$pageview');
})();
</script>
{%- endif %}
<script src="/assets/js/main.js?v={{ assetVersions.js }}"></script>
{# The Netlify Identity widget used to load here, on every page of the site, to
   catch an invite link and bounce the visitor to /admin. It went with
   git-gateway on 7 Aug 2026. Editors now sign in with GitHub at /admin itself,
   so no third-party script needs to run for the other 145 pages. #}
</body>
</html>

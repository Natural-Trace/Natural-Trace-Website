---
layout: base.njk
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "datePublished": "{{ date | date("%Y-%m-%d") }}",
  "author": {"@type": "Organization", "name": "Natural Trace"},
  "description": "{{ summary }}",
  "publisher": {
    "@type": "Organization",
    "name": "Natural Trace",
    "url": "{{ site.url }}"
  }
}
</script>

<section class="insight-post">
  <div class="container">
    <div class="insight-post-header">
      <a href="/insights/" class="back-link">Back to Insights</a>
      <span class="section-label">Insights</span>
      <h1>{{ title }}</h1>
      <div class="insight-meta">
        <time datetime="{{ date | date("%Y-%m-%d") }}">{{ date | date("%B %d, %Y") }}</time>
        {% if author %}<span class="insight-author">by {{ author }}</span>{% endif %}
      </div>
      {% if tags %}
      <div class="insight-tags">
        {#- A tag is a link only once enough articles share it to justify a page.
            See the threshold in .eleventy.js. Below it the tag still labels the
            article, it just does not lead anywhere empty. -#}
        {% for tag in tags %}
        {% if tag in collections.tagsWithPages %}<a class="insight-tag" href="/insights/tag/{{ tag | tagSlug }}/">{{ tag }}</a>{% else %}<span class="insight-tag">{{ tag }}</span>{% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>

    {% if image %}
    <figure class="insight-featured-image">
      {#- alt falls back to the headline, which is better than nothing and
          worse than a real description, so the CMS offers a field for it. -#}
      <img src="{{ image }}" alt="{{ image_alt or title }}">
      {% if image_caption %}<figcaption>{{ image_caption }}</figcaption>{% endif %}
    </figure>
    {% endif %}

    <div class="insight-body">
      {{ content | safe }}
    </div>

    <div class="insight-footer">
      <a href="/insights/" class="back-link">All Insights</a>
      <a href="/contact/" class="cta-link">Get in Touch</a>
    </div>
  </div>
</section>

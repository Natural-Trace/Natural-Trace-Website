{#- Cookie consent + gated analytics.
    Nothing that sets a cookie loads until the visitor accepts. The choice is
    kept in localStorage, which is strictly necessary and sets no cookie itself.
    Closes the "no cookie consent banner" defect from the 30 July review.

    Two things answer to this banner and they behave differently. HubSpot does
    not load at all until Accept. PostHog is already running cookieless from
    base.njk; Accept switches it to a cookie, Decline leaves it as it is. So
    the bar is wanted when either is configured, not only HubSpot. -#}
{% set hsPortal = integrations.hubspot.portal_id %}
{% set wantHubSpot = integrations.tracking.enabled and hsPortal %}
{% set wantPostHog = integrations.posthog.enabled and integrations.posthog.token %}
{% if integrations.consent.enabled and (wantHubSpot or wantPostHog) %}
<div class="consent" id="consentBar" role="region" aria-label="Cookie choice" hidden>
  <p>{{ integrations.consent.message }} <a href="{{ integrations.consent.policy_url }}">{{ integrations.consent.policy_label }}</a></p>
  <div class="consent-actions">
    <button type="button" class="consent-decline" id="consentDecline">{{ integrations.consent.decline_label }}</button>
    <button type="button" class="consent-accept" id="consentAccept">{{ integrations.consent.accept_label }}</button>
  </div>
</div>
<script>
(function () {
  var KEY = 'nt-consent';
  var HUBSPOT = {% if wantHubSpot %}true{% else %}false{% endif %};
  var PORTAL = {{ hsPortal | dump | safe }};
  var REGION = {{ integrations.hubspot.region | dump | safe }};

  function loadAnalytics() {
    if (!HUBSPOT) return;
    if (document.getElementById('hs-script-loader')) return;
    var s = document.createElement('script');
    s.id = 'hs-script-loader';
    s.async = true; s.defer = true; s.type = 'text/javascript';
    /* na1 is the original region and uses the bare hostname. Every other
       region suffixes it: na2 -> js-na2, eu1 -> js-eu1. This used to special
       case eu1 only, which would have quietly loaded the wrong region's script
       for the na2 portal. Verified: js-na2.hs-scripts.com/23458507.js is 200,
       js.hs-scripts.com/23458507.js is a 307 redirect. */
    s.src = '//js' + (REGION === 'na1' ? '' : '-' + REGION) + '.hs-scripts.com/' + PORTAL + '.js';
    document.head.appendChild(s);
  }

  var bar = document.getElementById('consentBar');
  var choice = null;
  try { choice = localStorage.getItem(KEY); } catch (e) {}

  /* Global Privacy Control, and the older Do Not Track, are a visitor saying
     no before being asked. With either one set and no choice stored, the bar
     is not shown and the visitor is treated as having declined: HubSpot never
     loads and PostHog stays cookieless, which is what no-choice already means
     in base.njk. Nothing is written to storage, so turning the signal off
     brings the bar back. The "Cookie settings" link in the footer still opens
     it, so someone sending GPC can still choose to accept. Added 13 Oct 2026. */
  var signalledNo = navigator.globalPrivacyControl === true ||
    navigator.doNotTrack === '1' || window.doNotTrack === '1';

  if (choice === 'accepted') { loadAnalytics(); }
  else if (choice !== 'declined' && !signalledNo && bar) { bar.hidden = false; }

  function decide(value) {
    try { localStorage.setItem(KEY, value); } catch (e) {}
    if (bar) bar.hidden = true;
    if (value === 'accepted') loadAnalytics();
    /* PostHog is already running cookieless (see base.njk). Accept switches it
       to a cookie; Decline tells it to stay as it is. Both queue safely if
       array.js has not arrived yet, because the stub records the call. */
    if (window.posthog) {
      if (value === 'accepted') {
        posthog.opt_in_capturing();
        posthog.startSessionRecording();
      } else {
        posthog.stopSessionRecording();
        posthog.opt_out_capturing();
      }
    }
  }

  /* Withdrawing consent has to be as easy as giving it (GDPR Art. 7(3)), and
     until 13 Oct there was no way back once a choice was stored: the bar never
     returned. The footer's "Cookie settings" button calls this to show the bar
     again with focus on it. Choosing Decline there stops replay at once and
     returns PostHog to cookieless. HubSpot's cookies, once set, stay until the
     visitor clears them; the reload after a change of mind stops HubSpot
     loading again. */
  window.ntOpenConsent = function () {
    if (!bar) return;
    bar.hidden = false;
    var first = document.getElementById('consentDecline');
    if (first) first.focus();
  };
  var a = document.getElementById('consentAccept');
  var d = document.getElementById('consentDecline');
  var before = choice;
  function choose(value) {
    decide(value);
    /* A visitor who had accepted and now declines has HubSpot already running
       on this page. Reloading is the only way to unload it. */
    if (before === 'accepted' && value === 'declined') location.reload();
    before = value;
  }
  if (a) a.addEventListener('click', function () { choose('accepted'); });
  if (d) d.addEventListener('click', function () { choose('declined'); });
})();
</script>
{% endif %}

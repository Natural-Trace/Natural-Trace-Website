{#- Organisation + WebSite structured data, emitted on every page.
    Facts only: name, founding year, location, contact, profiles. No capability
    claims here, so nothing in this block needs claim sign-off. -#}
{#- The breadcrumb trail, built from the URL by the breadcrumbTrail filter in
    .eleventy.js; see the comment there for how levels are chosen and why this
    was missing until 7 Sep 2026. A trail of one is the home page and gets no
    BreadcrumbList: a breadcrumb naming only itself tells a reader nothing and
    Google ignores it. -#}
{%- set trail = page.url | breadcrumbTrail(collections.all) -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ (site.url + "/#organization") | dump | safe }},
      "name": {{ site.name | dump | safe }},
      "legalName": {{ site.legal_name | dump | safe }},
      "url": {{ site.url | dump | safe }},
      "logo": {{ (site.url + site.logo) | dump | safe }},
      "description": {{ site.default_summary | dump | safe }},
      "foundingDate": {{ site.founding_year | dump | safe }},
      "address": {
        "@type": "PostalAddress",
        "addressLocality": {{ site.locality | dump | safe }},
        "addressCountry": {{ site.country | dump | safe }}
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": {{ site.email | dump | safe }}
      },
      "sameAs": [{% for s in site.social %}{{ s | dump | safe }}{% if not loop.last %},{% endif %}{% endfor %}]
    },
    {
      "@type": "WebSite",
      "@id": {{ (site.url + "/#website") | dump | safe }},
      "url": {{ site.url | dump | safe }},
      "name": {{ site.name | dump | safe }},
      "publisher": { "@id": {{ (site.url + "/#organization") | dump | safe }} }
    },
    {
      "@type": "WebPage",
      "@id": {{ (site.url + page.url) | dump | safe }},
      "url": {{ (site.url + page.url) | dump | safe }},
      "name": {{ seoTitle | dump | safe }},
      "description": {{ seoDescription | dump | safe }},
      "isPartOf": { "@id": {{ (site.url + "/#website") | dump | safe }} },
      "about": { "@id": {{ (site.url + "/#organization") | dump | safe }} }{% if trail | length > 1 %},
      "breadcrumb": { "@id": {{ (site.url + page.url + "#breadcrumb") | dump | safe }} }{% endif %}
    }{% if trail | length > 1 %},
    {
      "@type": "BreadcrumbList",
      "@id": {{ (site.url + page.url + "#breadcrumb") | dump | safe }},
      "itemListElement": [{% for crumb in trail %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": {{ crumb.name | dump | safe }},
          "item": {{ (site.url + crumb.url) | dump | safe }}
        }{% if not loop.last %},{% endif %}{% endfor %}
      ]
    }{% endif %}
  ]
}
</script>

{# White hero, 8 Aug, from Kirsty's mockup. The photographic background and
   its dark overlay are gone; hero_bg_image is left in the data and in the CMS
   because reverting is then a template change, not a content migration. #}
<section class="hero hero-light">
  <div class="hero-content">
    <div class="hero-copy">
      <h1>
        {# data-single-line is read by scripts/layout-audit.mjs. The headline
           breaking across three lines is the fault this whole hero was rebuilt
           around; this makes it fail a check rather than wait to be noticed. #}
        <span class="hero-line"><span class="hero-line-inner" data-single-line>{{ home.hero_title_line1 }}</span></span>
        <span class="hero-line"><span class="hero-line-inner" data-single-line><em>{{ home.hero_title_line2 }}</em></span></span>
      </h1>
      {# Kirsty's positioning line, verbatim, now opening the lead paragraph.
         It used to sit above the H1 as an eyebrow label. #}
      <p class="hero-lead"><strong>{{ home.hero_slogan }}.</strong> {{ home.hero_desc }}</p>
      {# The mockup shows these as a ticked list rather than one long sentence. #}
      <ul class="hero-ticks">
        {% for c in home.hero_claims %}<li>{{ c }}</li>{% endfor %}
      </ul>
      {% if home.hero_claims_coda %}<p class="hero-ticks-coda">...{{ home.hero_claims_coda }}.</p>{% endif %}
      <div class="hero-actions">
        <a href="{{ home.hero_cta_url }}" class="btn btn-primary" style="cursor:pointer">{{ home.hero_cta }}</a>
        <a href="{{ home.hero_cta_secondary_url }}" class="btn btn-outline-dark" style="cursor:pointer">{{ home.hero_cta_secondary }}</a>
      </div>
    </div>
    <div class="hero-visual"><img src="{{ home.hero_image }}" alt="{{ home.hero_image_alt }}" loading="eager"></div>
  </div>
</section>

<!-- Section 2: The Challenge -->
<section class="challenge" id="challenge">
  <div class="container">
    <div class="challenge-grid">
      <div class="challenge-text">
        <span class="section-label">{{ home.challenge_label }}</span>
        <h2 class="section-title">{{ home.challenge_title }}</h2>
        <p class="challenge-lead">{{ home.challenge_lead }}</p>
        <p class="challenge-sub">{{ home.challenge_list_label }}</p>
        <ul class="challenge-list">
          {% for item in home.challenge_list %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <p class="challenge-close">{{ home.challenge_close }}</p>
      </div>
      <div class="challenge-media">
        <img src="{{ home.challenge_image }}" alt="{{ home.challenge_image_alt }}" loading="lazy">
      </div>
    </div>
  </div>
</section>

{#- Value proposition icons. Drawn to match the set in the design, and
    kept here rather than as five image files so they inherit colour, stay
    sharp at any size and cost no extra requests. -#}
{%- set vpIcons = {
  "target": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="8.2"/><circle cx="12" cy="12" r="4.2"/><circle cx="12" cy="12" r="1"/></svg>',
  "factory": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M3 20V10l5.5 3.4V10L14 13.4V6.6h3.2L18 20z"/><path d="M2.5 20h19"/></svg>',
  "origin": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 3.2 20.2 12 12 20.8 3.8 12z"/><path d="M12 8.4 15.6 12 12 15.6 8.4 12z"/></svg>',
  "search": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="10.6" cy="10.6" r="6.4"/><path d="M15.4 15.4 20.4 20.4"/></svg>',
  "shield": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M12 3.2 19 6v5.6c0 4-2.9 7.4-7 9.2-4.1-1.8-7-5.2-7-9.2V6z"/><path d="M9.2 12.1l2 2 3.6-3.9"/></svg>'
} -%}
<!-- Section 3: Value Proposition -->
<section class="valueprop" id="value">
  <div class="container">
    <div class="vp-head">
      <span class="section-label">{{ home.vp_label }}</span>
      <h2 class="section-title">{{ home.vp_title }}</h2>
      <p class="section-subtitle">{{ home.vp_subtitle }}</p>
    </div>
    <div class="vp-grid vp-grid-centred">
      {% for card in home.vp_cards %}
      <article class="vp-card">
        <div class="vp-card-head">
          <span class="vp-icon" aria-hidden="true">{{ vpIcons[card.icon] | safe }}</span>
          <h3>{{ card.title }}</h3>
        </div>
        {# The problem needs no label. It reads as the problem, and the card is
           shorter without it, which is the point of the layout. "Our value"
           below stays, because that line is the answer and wants marking. #}
        <div class="vp-block">
          <p>{{ card.problem }}</p>
        </div>
        <div class="vp-block is-value">
          <span class="vp-block-label">{{ home.vp_value_label }}</span>
          <p>{{ card.value }}</p>
        </div>
      </article>
      {% endfor %}
    </div>
    <p class="section-more"><a href="/naturaltag/#how-it-works">See how it works, four steps from ingredient to evidence</a></p>
  </div>
</section>

<!-- Section 4: How It Works -->
{# Compact on purpose. Four steps across one row, and the detail behind a
   disclosure, so the section costs roughly one screen instead of four.

   <details> and <summary> are used rather than a hover or a scripted panel:
   they work with a tap, they work from a keyboard, a screen reader announces
   the open and closed state, and the text is in the page whether or not it is
   showing. A hover would fail all four. #}
<section class="howitworks howitworks-compact" id="how-it-works">
  <div class="container">
    <div class="how-head">
      <span class="section-label">{{ home.how_label }}</span>
      <h2 class="section-title">{{ home.how_title }}</h2>
    </div>
    <ol class="how-grid how-grid-compact">
      {% for step in home.how_steps %}
      <li class="how-step">
        <div class="how-step-num">{{ step.num }}</div>
        <h3>{{ step.title }}</h3>
        <p>{{ step.description }}</p>
      </li>
      {% endfor %}
    </ol>
    {% if home.how_features %}
    <details class="how-more">
      <summary>{{ home.how_features_label }}</summary>
      <ul class="how-facts">
        {% for feature in home.how_features %}<li>{{ feature }}</li>{% endfor %}
      </ul>
    </details>
    {% endif %}
  </div>
</section>

<!-- Section 5: Industry Tiles -->
<section class="home-industries" id="industries">
  <div class="container">
    <div class="industries-header">
      <span class="section-label">{{ home.industries_label }}</span>
      <h2 class="section-title">{{ home.industries_title }}</h2>
    </div>
    <div class="industries-grid">
      {% for industry in home.industry_tiles %}
      <a class="industry-card" href="{{ industry.url }}">
        <img src="{{ industry.image }}" alt="{{ industry.image_alt }}" loading="lazy">
        <div class="industry-card-overlay"><h3>{{ industry.name }}</h3><p>{{ industry.description }}</p></div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Partners Trust Bar -->
<div class="trust-bar">
  <div class="container">
    <span class="trust-label">{{ home.trust_label }}</span>
  </div>
  {#
    Continuous logo rail. The set is repeated four times and the track slides by
    exactly one set (25% of four), so the loop is seamless. Four copies rather
    than two because the loop only stays gapless while (copies - 1) sets are
    wider than the viewport; one set is roughly 1500px, so two copies would tear
    on anything above about 1500px wide.

    Spacing is margin-right on each logo, not flex gap. With gap, half the track
    is one set plus half a gap, and the loop jumps by that half gap every cycle.

    Copies 2 to 4 are hidden from screen readers and skipped by the tab key, so
    the eight partners are announced once, not thirty-two times.
  #}
  <div class="trust-marquee">
    <div class="trust-track">
      {% for i in range(0, 4) %}
      <div class="trust-set"{% if i > 0 %} aria-hidden="true"{% endif %}>
        {% for logo in home.trust_logos %}
        <a class="trust-logo" href="{{ logo.url }}" target="_blank" rel="noopener"{% if i > 0 %} tabindex="-1"{% endif %}><img src="{{ logo.image }}" alt="{% if i == 0 %}{{ logo.alt }}{% endif %}"></a>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<!-- Final Call to Action -->
<section class="finalcta">
  <div class="container">
    <div class="finalcta-inner">
      <h2>{{ home.final_cta_title }}</h2>
      <p>{{ home.final_cta_text }}</p>
      <div class="finalcta-actions">
        <a href="{{ home.final_cta_primary_url }}" class="btn btn-white" style="cursor:pointer">{{ home.final_cta_primary }}</a>
        {# Second button only renders when someone has given it a label, so it
           can be removed and restored from the CMS without touching code. #}
        {% if home.final_cta_secondary %}<a href="{{ home.final_cta_secondary_url }}" class="btn btn-ghost" style="cursor:pointer">{{ home.final_cta_secondary }}</a>{% endif %}
      </div>
      <p class="finalcta-alt"><a href="/assess/">Or check your product yourself in 60 seconds</a></p>
    </div>
  </div>
</section>
